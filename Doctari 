<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Shannon!</title>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Outfit:wght@300;400;600&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">
    <style>
        /* [KEEP YOUR EXISTING BASE RESET, GRADIENT BG, AND PARTICLES CSS HERE] */
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(-45deg, #2b0b30, #61184c, #9c2162, #ff275d, #ffdf85);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            perspective: 1000px;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Particles */
        .particles { position: absolute; width: 100%; height: 100%; z-index: 1; }
        .particle { position: absolute; animation: floatUp 10s linear infinite; opacity: 0.6; }
        @keyframes floatUp {
            0% { transform: translateY(110vh) scale(0); opacity: 0; }
            100% { transform: translateY(-10vh) scale(1); opacity: 0; }
        }

        /* Container & Sections */
        .container { position: relative; z-index: 10; text-align: center; width: 100%; }
        .section { display: none; }
        .section.active { display: flex; flex-direction: column; align-items: center; }

        /* Gift Box Styles */
        .gift-wrapper { cursor: pointer; transition: 0.3s; position: relative; }
        .gift-box { width: 160px; height: 150px; background: #ff4d4d; border-radius: 12px; position: relative; }
        .gift-lid { position: absolute; top: -20px; left: -10px; width: 180px; height: 40px; background: #cc0000; z-index: 2; transition: 0.5s; }
        .gift-wrapper:hover .gift-lid { transform: translateY(-10px); }

        /* The 3D Cake Styling */
        .cake-wrapper { position: relative; width: 250px; height: 200px; cursor: crosshair; margin-top: 50px; }
        .cake { position: relative; width: 100%; height: 100%; transition: 1s; }
        .cake-body { width: 200px; height: 120px; background: #f39c12; border-radius: 10px; margin: 0 auto; position: relative; box-shadow: 0 10px #e67e22; }
        .frosting { width: 210px; height: 40px; background: #fff; border-radius: 20px; position: absolute; top: -10px; left: -5px; }
        
        .candle { width: 10px; height: 40px; background: #e74c3c; position: absolute; top: -45px; left: 50%; transform: translateX(-50%); }
        .flame { 
            width: 15px; height: 20px; background: #f1c40f; border-radius: 50% 50% 20% 20%; 
            position: absolute; top: -20px; left: -2px; animation: flicker 0.1s infinite;
            box-shadow: 0 0 15px #f1c40f;
        }

        @keyframes flicker { 0% { transform: scale(1); } 100% { transform: scale(1.1); } }

        /* Split Animation */
        .cake-left, .cake-right { position: absolute; width: 50%; height: 100%; transition: 1s; overflow: hidden; }
        .cake-left { left: 0; } .cake-right { right: 0; }
        .cake.cut .cake-left { transform: translateX(-50px) rotate(-10deg); }
        .cake.cut .cake-right { transform: translateX(50px) rotate(10deg); }

        /* Glass Card */
        .glass-card {
            background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(15px);
            padding: 40px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.2);
            max-width: 500px; animation: fadeIn 1s;
        }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        h1 { font-family: 'Dancing Script', cursive; font-size: 3.5rem; color: #ffdf85; }
        .btn { 
            margin-top: 20px; padding: 15px 30px; border-radius: 50px; border: none; 
            background: #ff275d; color: white; font-weight: bold; cursor: pointer; transition: 0.3s;
        }
        .btn:hover { transform: scale(1.1); background: #ff4d4d; }
    </style>
</head>

<body>
    <div class="particles" id="particles"></div>

    <div class="container">
        <div id="stage-gift" class="section active">
            <div class="gift-wrapper" onclick="openGift()">
                <div class="gift-lid"></div>
                <div class="gift-box"></div>
                <p class="tap-text">A special delivery for Shannon...</p>
            </div>
        </div>

        <div id="stage-cake" class="section">
            <h2 class="cake-instruction">Make a wish, Shannon!</h2>
            <div class="cake-wrapper" onclick="cutCake(this)">
                <div class="cake" id="main-cake">
                    <div class="candle"><div class="flame"></div></div>
                    <div class="cake-body">
                        <div class="frosting"></div>
                    </div>
                </div>
            </div>
            <p style="margin-top:20px;">(Click the cake to cut a slice!)</p>
        </div>

        <div id="stage-message" class="section">
            <div class="glass-card">
                <h1>Happy Birthday, Shannon Easter!</h1>
                <p style="font-size: 1.2rem; line-height: 1.6; margin-top: 15px;">
                    To my beautiful love, may your day be as radiant as your smile. 
                    I hope this year brings you all the happiness you deserve. 
                    You make every day brighter! ❤️
                </p>
                <button class="btn" onclick="location.reload()">See it again!</button>
            </div>
        </div>
    </div>

    <script>
        // 1. Generate Floating Particles (Hearts & Dots)
        const particlesContainer = document.getElementById('particles');
        const particleCount = 40;

        for (let i = 0; i < particleCount; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            const isHeart = Math.random() > 0.5;
            p.innerHTML = isHeart ? '❤️' : '✨';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.animationDuration = (Math.random() * 5 + 5) + 's';
            p.style.animationDelay = Math.random() * 5 + 's';
            p.style.fontSize = (Math.random() * 10 + 10) + 'px';
            particlesContainer.appendChild(p);
        }

        // 2. Transition Logic
        function openGift() {
            document.querySelector('.gift-lid').style.transform = "translateY(-150px) rotate(20deg)";
            document.querySelector('.gift-lid').style.opacity = "0";
            setTimeout(() => {
                showSection('stage-cake');
            }, 800);
        }

        function cutCake(wrapper) {
            const cake = document.getElementById('main-cake');
            cake.classList.add('cut');
            // Create a burst of hearts
            for(let i=0; i<15; i++) { createHeartBurst(wrapper); }
            
            setTimeout(() => {
                showSection('stage-message');
            }, 1500);
        }

        function showSection(id) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
        }

        function createHeartBurst(parent) {
            const heart = document.createElement('div');
            heart.innerHTML = '❤️';
            heart.style.position = 'absolute';
            heart.style.left = '50%';
            heart.style.top = '50%';
            heart.style.fontSize = '24px';
            heart.style.pointerEvents = 'none';
            heart.style.transition = 'all 1s ease-out';
            parent.appendChild(heart);

            const x = (Math.random() - 0.5) * 400;
            const y = (Math.random() - 0.5) * 400;
            
            setTimeout(() => {
                heart.style.transform = `translate(${x}px, ${y}px) scale(0)`;
                heart.style.opacity = '0';
            }, 10);

            setTimeout(() => heart.remove(), 1000);
        }
    </script>
</body>
</html>
